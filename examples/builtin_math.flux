// Test builtin: math operations (abs, min, max, pow)

print("=== abs (absolute value) ===")
abs(-5) |> print
abs(10) |> print
abs(-42) |> print

print("=== min ===")
min(10, 20) |> print
min(5, 3) |> print

print("=== max ===")
max(10, 20) |> print
max(5, 3) |> print

print("=== pow (power) ===")
pow(2, 3) |> print
pow(5, 2) |> print
pow(10, 0) |> print
